<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/subtitle"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:paddingTop="4dp"
            android:paddingBottom="18dp" />

        <!-- 设备序列号 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_sn"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />
        <EditText
            android:id="@+id/etSn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_sn"
            android:inputType="text"
            android:textSize="14sp"
            android:maxLines="1" />

        <!-- RSA 私钥 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_key"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:paddingTop="16dp" />
        <EditText
            android:id="@+id/etKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_key"
            android:inputType="textMultiLine|textNoSuggestions"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:minLines="4"
            android:maxLines="9"
            android:gravity="top"
            android:scrollbars="vertical"
            />
        <Button
            android:id="@+id/btnLoadKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_load_key"
            android:textAllCaps="false" />

        <!-- 到期时间 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_expire"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:paddingTop="16dp" />
        <TextView
            android:id="@+id/tvExpire"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/accent"
            android:paddingTop="2dp"
            android:paddingBottom="6dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/btnPickTime" android:layout_width="0dp" android:layout_weight="1.2"
                android:layout_height="wrap_content" android:text="@string/btn_pick_time" android:textAllCaps="false" android:textSize="12sp" />
            <Button android:id="@+id/btnD30" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="@string/btn_d30" android:textAllCaps="false" android:textSize="12sp" />
            <Button android:id="@+id/btnD90" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="@string/btn_d90" android:textAllCaps="false" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/btnD365" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="@string/btn_d365" android:textAllCaps="false" android:textSize="12sp" />
            <Button android:id="@+id/btnLong" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="@string/btn_long" android:textAllCaps="false" android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnGenerate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_generate"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:layout_marginTop="18dp" />

        <!-- 结果 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_result"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:paddingTop="18dp" />
        <EditText
            android:id="@+id/etResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine|textNoSuggestions"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:minLines="3"
            android:maxLines="8"
            android:gravity="top"
            android:textIsSelectable="true"
            android:scrollbars="vertical"
            />
        <Button
            android:id="@+id/btnCopy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_copy"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:paddingTop="12dp" />

    </LinearLayout>
</ScrollView>
